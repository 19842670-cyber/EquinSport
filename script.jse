/* CONTADOR DE PRODUCTOS */

let cantidadProductos = 0;

function agregarProducto(nombre) {

    cantidadProductos++;

    const contador = document.getElementById("contador");

    if (contador) {
        contador.textContent = cantidadProductos;
    }

    alert(
        "🐴 " + nombre +
        " fue agregado correctamente.\n\n" +
        "Productos en tu compra: " +
        cantidadProductos
    );
}


/* JAVASCRIPT */

function mostrarMensaje() {

    alert(
        "¡Hola! 👋\n\n" +
        "Este mensaje fue creado utilizando JavaScript."
    );
}


/* JQUERY - SIMULACIÓN DE UNA FUNCIÓN */

function cambiarTexto() {

    const texto = document.getElementById("textoJquery");

    if (texto) {

        texto.textContent =
            "¡El texto cambió gracias a una función interactiva! 🐴";

        texto.style.color = "#596B45";
        texto.style.fontWeight = "bold";
    }
}


/* JSON */

function mostrarJSON() {

    const producto = {

        nombre: "Montura Vaquera",
        precio: 350,
        categoria: "Caballo",
        disponible: true

    };

    const resultado =
        document.getElementById("productoJson");

    if (resultado) {

        resultado.innerHTML =
            "<strong>Producto:</strong> " +
            producto.nombre +
            "<br><strong>Precio:</strong> $" +
            producto.precio +
            "<br><strong>Categoría:</strong> " +
            producto.categoria +
            "<br><strong>Disponible:</strong> Sí";
    }
}


