/* CUESTIONARIO */

function calificarQuiz() {

    let puntos = 0;

    const preguntas = [
        "p1",
        "p2",
        "p3",
        "p4",
        "p5"
    ];

    preguntas.forEach(function(nombre) {

        const respuesta =
            document.querySelector(
                'input[name="' + nombre + '"]:checked'
            );

        if (respuesta && respuesta.value === "correcto") {
            puntos++;
        }

    });

    const resultado =
        document.getElementById("resultado");

    if (!resultado) {
        return;
    }

    resultado.style.display = "block";

    let mensaje = "";

    if (puntos === 5) {

        mensaje =
            "🏆 ¡Excelente! Sacaste 5 de 5.";

    } else if (puntos >= 3) {

        mensaje =
            "👏 ¡Muy bien! Sacaste " +
            puntos +
            " de 5.";

    } else {

        mensaje =
            "📚 Sacaste " +
            puntos +
            " de 5. ¡Sigue estudiando!";
    }

    resultado.textContent = mensaje;

    window.scrollTo({
        top: resultado.offsetTop - 100,
        behavior: "smooth"
    });
}


